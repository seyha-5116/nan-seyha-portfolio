# PostgreSQL connection string used by Prisma.
#
# When this is set, project data and contact messages are read from / written to
# the database. When it is left unset, the site runs fully offline with bundled
# seed data (see lib/seed-projects.ts) and the contact form reports a graceful
# error pointing at direct channels.
#
# Example (Neon / Supabase / local):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# Used for canonical URLs and Open Graph metadata.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"