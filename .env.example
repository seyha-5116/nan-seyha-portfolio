# PostgreSQL connection string used by Prisma.
#
# When this is set, project data and contact messages are read from / written to
# the database. When it is left unset, the site runs fully offline with bundled
# seed data (see lib/seed-projects.ts) and the contact form reports a graceful
# error pointing at direct channels.
#
# Example (Neon / Supabase / local):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# Resend API key for contact-form email delivery (https://resend.com).
#
# When set, contact-form submissions are emailed to nanseyha4@gmail.com via
# Resend. When unset, the form falls back to database persistence (then to a
# graceful offline message if the database is also unavailable).
# RESEND_API_KEY="re_xxxxxxxxxxxx"

# "From" address for contact emails. Use the sandbox address while developing,
# or a sender on your verified domain for production (e.g. "contact@seyha.dev").
# CONTACT_FROM="contact@seyha.dev"

# Used for canonical URLs and Open Graph metadata.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"